# URL da API NestJS — SÓ usada no servidor (rewrite em next.config.mjs +
# lib/session.ts). O browser nunca chama isso diretamente, sempre fala com
# o próprio domínio do Next em /api/*, que faz o proxy — ver comentário em
# next.config.mjs pra entender por quê (cookie de sessão cross-domain).
API_URL=http://localhost:3333
