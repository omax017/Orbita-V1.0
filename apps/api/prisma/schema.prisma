// Schema Prisma da Órbita (nome anterior do produto: Hubwin).
//
// Estratégia de multi-tenancy: schema compartilhado (shared schema) com
// coluna `workspaceId` em toda tabela de domínio. Módulos de domínio
// (Pedidos, Anúncios, Estoque, Financeiro, Ads, Descobrir) seguem o mesmo
// padrão: FK para Workspace + `@@index([workspaceId])`.
//
// Em algumas tabelas de altíssimo volume/analíticas (OrderItem,
// AdMetricDaily) o `workspaceId` é denormalizado (duplicado a partir do
// registro pai) de propósito, para permitir filtrar/agregar por workspace
// sem precisar de JOIN em toda query de relatório (Resumo/ABC/DRE).
//
// Algumas referências são polimórficas por design (ex: FinancialMovement.
// referenceId, Alert.referenceId) — não há FK de banco para elas porque
// podem apontar para tabelas diferentes dependendo do `referenceType`; a
// integridade é validada na camada de aplicação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Núcleo: Workspace (conta/loja), User, Membership
// =============================================================================

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  PENDING
  REVOKED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  document  String? // CNPJ/CPF do lojista, opcional (usado em nota fiscal/cobrança)
  currency  String   @default("BRL")
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         Membership[]
  marketplaceAccounts MarketplaceAccount[]
  skus                Sku[]
  listings            Listing[]
  orders              Order[]
  adCampaigns         AdCampaign[]
  financialMovements  FinancialMovement[]
  alerts              Alert[]
  notifications       Notification[]
  searchHistories     SearchHistory[]
  subscriptions       Subscription[]
  usageCounters       UsageCounter[]

  @@map("workspaces")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String? // null enquanto convite pendente ou login via OAuth futuro
  avatarUrl       String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships        Membership[]
  notifications      Notification[]
  searchHistories     SearchHistory[]
  financialMovements  FinancialMovement[] @relation("FinancialMovementCreatedBy")
  sessions            Session[]

  @@map("users")
}

/// Sessão de login (par de tokens). O access token (JWT de vida curta) nunca
/// é persistido — só validado por assinatura. O refresh token é opaco
/// (random bytes) e só o HASH dele é gravado aqui, para uma linha comprometida
/// no banco não permitir forjar sessões. `revokedAt` é setado no logout e na
/// rotação (a cada `POST /auth/refresh` a sessão antiga é revogada e uma nova
/// é criada) — isso detecta reuso de refresh token roubado.
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Membership {
  id           String           @id @default(cuid())
  workspaceId  String
  userId       String
  role         Role             @default(MEMBER)
  invitedEmail String?
  status       MembershipStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@map("memberships")
}

// =============================================================================
// Integrações de marketplace
// =============================================================================

enum MarketplaceProvider {
  MERCADO_LIVRE
  SHOPEE
}

enum MarketplaceAccountStatus {
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED
}

model MarketplaceAccount {
  id                  String                   @id @default(cuid())
  workspaceId         String
  provider            MarketplaceProvider
  externalAccountId   String
  externalAccountName String
  status              MarketplaceAccountStatus @default(DISCONNECTED)
  // accessToken/refreshToken: sempre criptografados na camada de aplicação
  // antes de persistir (nunca texto puro), independente do tipo de coluna aqui.
  accessToken         String?
  refreshToken        String?
  tokenExpiresAt      DateTime?
  scopes              String[]
  lastSyncedAt        DateTime?
  lastSyncError       String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders      Order[]
  listings    Listing[]
  adCampaigns AdCampaign[]

  @@unique([workspaceId, provider, externalAccountId])
  @@index([workspaceId])
  @@map("marketplace_accounts")
}

// =============================================================================
// Catálogo: SKU/Produto e Listing (anúncio), com vínculo N:N
// =============================================================================

model Sku {
  id                 String   @id @default(cuid())
  workspaceId        String
  code               String // código interno definido pelo seller (SKU)
  name               String
  description        String?
  costAmount         Decimal  @default(0) @db.Decimal(12, 2)
  // Custo de embalagem — separado de costAmount porque é um custo fixo por
  // unidade despachada, independente do produto (ex.: mesma caixa pra vários
  // SKUs), útil de reportar/editar separado no módulo Estoque.
  packagingCostAmount Decimal @default(0) @db.Decimal(12, 2)
  currency           String   @default("BRL")
  barcode            String?
  weightGrams        Int?
  imageUrl           String?
  // Estoque próprio (armazenado/despachado pelo seller) vs. estoque em posse
  // do marketplace (Mercado Envios Full / Shopee) — bem distintos na prática
  // (o seller só reabastece o local; o Full é repassado em lote e demora).
  stockLocal         Int      @default(0)
  stockFull          Int      @default(0)
  // Abaixo desse total (local+full) o SKU entra em alerta de "estoque baixo"
  // no painel — cada produto pode ter um limite diferente (giro diferente).
  lowStockThreshold  Int      @default(5)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listingSkus ListingSku[]
  orderItems  OrderItem[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@map("skus")
}

enum ListingStatus {
  ACTIVE
  PAUSED
  CLOSED
  UNDER_REVIEW
}

model Listing {
  id                   String              @id @default(cuid())
  workspaceId          String
  marketplaceAccountId String
  // Denormalizado a partir de marketplaceAccount.provider — evita JOIN para
  // filtrar/agrupar anúncios por marketplace nas telas de Anúncios/Descobrir.
  provider             MarketplaceProvider
  externalListingId    String
  title                String
  status               ListingStatus       @default(ACTIVE)
  permalink            String?
  thumbnailUrl         String?
  currency             String              @default("BRL")
  price                Decimal             @db.Decimal(12, 2)
  availableQuantity    Int                 @default(0)
  soldQuantity         Int                 @default(0)
  categoryExternalId   String?
  categoryName         String?
  qualityScore         Float?
  rawPayload           Json?
  lastSyncedAt         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  listingSkus        ListingSku[]
  orderItems         OrderItem[]

  @@unique([marketplaceAccountId, externalListingId])
  @@index([workspaceId])
  @@index([marketplaceAccountId])
  @@map("listings")
}

/// Join N:N entre Listing e Sku. Um anúncio com variações (cor/tamanho) pode
/// mapear várias linhas aqui, uma por variação; um SKU pode estar vinculado a
/// anúncios diferentes (inclusive em marketplaces diferentes).
///
/// Atenção: quando não houver variação, grave `variationExternalId` como
/// string vazia ("") em vez de `null` — o Postgres trata cada `NULL` como
/// distinto em constraints UNIQUE, então múltiplos `null` não seriam
/// bloqueados como duplicata.
model ListingSku {
  id                  String   @id @default(cuid())
  listingId           String
  skuId               String
  variationExternalId String   @default("")
  createdAt           DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sku     Sku     @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([listingId, skuId, variationExternalId])
  @@index([skuId])
  @@map("listing_skus")
}

// =============================================================================
// Pedidos
// =============================================================================

enum OrderStatus {
  PENDING
  PAID
  IN_PREPARATION
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
}

model Order {
  id                   String              @id @default(cuid())
  workspaceId          String
  marketplaceAccountId String
  provider             MarketplaceProvider
  externalOrderId      String
  status               OrderStatus         @default(PENDING)
  marketplaceStatus    String? // status bruto retornado pela API do marketplace (debug/auditoria)
  buyerNickname        String?
  currency             String              @default("BRL")
  subtotalAmount       Decimal             @default(0) @db.Decimal(12, 2)
  shippingAmount       Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal             @default(0) @db.Decimal(12, 2)
  marketplaceFeeAmount Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal             @default(0) @db.Decimal(12, 2)
  costAmount           Decimal             @default(0) @db.Decimal(12, 2) // soma do custo dos itens
  // Cache calculado por um job (totalAmount - taxas - frete - custo - imposto
  // - ads alocado). Recalculado sempre que o pedido ou seus itens mudam.
  netProfitAmount      Decimal             @default(0) @db.Decimal(12, 2)
  rawPayload           Json?
  orderedAt            DateTime
  paidAt               DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  canceledAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  items              OrderItem[]

  @@unique([marketplaceAccountId, externalOrderId])
  @@index([workspaceId])
  @@index([workspaceId, orderedAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(cuid())
  workspaceId        String // denormalizado a partir de order.workspaceId (consultas analíticas)
  orderId            String
  listingId          String?
  skuId              String?
  externalItemId     String?
  title              String // snapshot do título do anúncio no momento da venda
  quantity           Int
  unitPriceAmount    Decimal  @db.Decimal(12, 2)
  // Snapshot do custo do SKU no momento da venda — não usar Sku.costAmount
  // atual para DRE histórico, pois o custo do produto muda com o tempo.
  unitCostAmount     Decimal  @default(0) @db.Decimal(12, 2)
  allocatedFeeAmount Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal  @db.Decimal(12, 2)
  netProfitAmount    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sku     Sku?     @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([orderId])
  @@index([listingId])
  @@index([skuId])
  @@map("order_items")
}

// =============================================================================
// Publicidade (Ads)
// =============================================================================

enum AdCampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

model AdCampaign {
  id                   String              @id @default(cuid())
  workspaceId          String
  marketplaceAccountId String
  provider             MarketplaceProvider
  externalCampaignId   String
  name                 String
  status               AdCampaignStatus    @default(ACTIVE)
  objective            String? // ex.: "PADS" (Mercado Livre), "Shopee Search Ads"
  dailyBudgetAmount    Decimal             @default(0) @db.Decimal(12, 2)
  startDate            DateTime?
  endDate              DateTime?
  lastSyncedAt         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount  @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  metrics            AdMetricDaily[]

  @@unique([marketplaceAccountId, externalCampaignId])
  @@index([workspaceId])
  @@map("ad_campaigns")
}

/// Métrica diária por campanha. CTR/ACOS/ROAS são derivados em tempo de
/// consulta (impressions/clicks/spend/revenue) em vez de armazenados, para
/// não ficarem desatualizados quando o cálculo de ACOS/ROAS mudar.
model AdMetricDaily {
  id                String   @id @default(cuid())
  workspaceId       String // denormalizado a partir de adCampaign.workspaceId
  adCampaignId      String
  date              DateTime @db.Date
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  spendAmount       Decimal  @default(0) @db.Decimal(12, 2)
  attributedRevenue Decimal  @default(0) @db.Decimal(12, 2)
  attributedOrders  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  adCampaign AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)

  @@unique([adCampaignId, date])
  @@index([workspaceId])
  @@map("ad_metrics_daily")
}

// =============================================================================
// Financeiro (Movimentações / DRE)
// =============================================================================

enum FinancialMovementType {
  ORDER_REVENUE
  MARKETPLACE_FEE
  SHIPPING_COST
  TAX
  AD_SPEND
  PRODUCT_COST
  REFUND
  WITHDRAWAL
  ADJUSTMENT
  OTHER
}

enum FinancialMovementSource {
  SYSTEM_SYNC
  MANUAL
  IMPORT
}

enum FinancialReferenceType {
  ORDER
  AD_CAMPAIGN
  MARKETPLACE_ACCOUNT
  MANUAL
}

/// Referência polimórfica por design: `referenceId` aponta para Order,
/// AdCampaign ou MarketplaceAccount dependendo de `referenceType`. Sem FK de
/// banco (não é possível referenciar tabelas diferentes na mesma coluna);
/// integridade garantida pela camada de aplicação.
model FinancialMovement {
  id              String                   @id @default(cuid())
  workspaceId     String
  type            FinancialMovementType
  category        String? // agrupamento livre para DRE customizado pelo seller
  amount          Decimal                  @db.Decimal(12, 2) // positivo = crédito, negativo = débito
  currency        String                   @default("BRL")
  referenceType   FinancialReferenceType   @default(MANUAL)
  referenceId     String?
  description     String?
  source          FinancialMovementSource  @default(SYSTEM_SYNC)
  occurredAt      DateTime
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("FinancialMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("financial_movements")
}

// =============================================================================
// Alertas e notificações
// =============================================================================

enum AlertType {
  LOW_STOCK
  LISTING_PAUSED
  HIGH_ACOS
  NEGATIVE_MARGIN
  // Pedido sincronizado cujo OrderItem não tem `skuId` vinculado — lucro real
  // não pode ser calculado. Gerado pelo job de pós-sincronização (Etapa 9).
  MISSING_COST
  SYNC_ERROR
  SUBSCRIPTION_ISSUE
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

/// Condição detectada pelo sistema (ex.: estoque baixo, ACOS alto). Uma
/// mesma Alert pode gerar várias Notification (uma por membro/canal).
model Alert {
  id            String        @id @default(cuid())
  workspaceId   String
  type          AlertType
  severity      AlertSeverity @default(INFO)
  title         String
  message       String
  referenceType String? // ex.: "Listing" | "Sku" | "AdCampaign" (informativo, sem FK)
  referenceId   String?
  status        AlertStatus   @default(OPEN)
  triggeredAt   DateTime      @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([workspaceId, status])
  @@map("alerts")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

/// Entrega individual de uma notificação a um usuário/canal. Pode ou não
/// estar ligada a uma Alert (ex.: "convite aceito" não tem Alert de origem).
model Notification {
  id          String               @id @default(cuid())
  workspaceId String
  alertId     String?
  userId      String
  channel     NotificationChannel  @default(IN_APP)
  status      NotificationStatus   @default(PENDING)
  title       String
  body        String
  payload     Json?
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  alert     Alert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, status])
  @@map("notifications")
}

// =============================================================================
// Descobrir (pesquisa de mercado/concorrentes)
// =============================================================================

model SearchHistory {
  id             String               @id @default(cuid())
  workspaceId    String
  userId         String
  provider       MarketplaceProvider?
  queryText      String
  filters        Json?
  // Snapshot cacheado do resultado (top sellers, preço médio, faixa de preço,
  // total de anúncios etc.) — evita reconsultar a origem a cada acesso ao histórico.
  resultsSummary Json?
  createdAt      DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("search_histories")
}

// =============================================================================
// Planos, assinatura e limites de uso
// =============================================================================

enum PlanCode {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

/// Catálogo de planos. `code` é o identificador estável usado em feature
/// gates no código; preço/limites ficam em dados (não em enum) para poder
/// ajustar sem migration.
model Plan {
  id              String          @id @default(cuid())
  code            PlanCode        @unique
  name            String
  priceAmount     Decimal         @default(0) @db.Decimal(12, 2)
  currency        String          @default("BRL")
  billingInterval BillingInterval @default(MONTHLY)
  features        Json? // ex.: { "abcCurve": true, "aiInsights": false }
  limits          Json? // ex.: { "maxMarketplaceAccounts": 2, "maxUsers": 3 }
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Histórico de assinaturas do workspace. Só deveria existir uma com status
/// ACTIVE/TRIALING por vez — regra validada na aplicação (o Postgres não
/// suporta unique parcial diretamente via Prisma; pode ser adicionado depois
/// via migration manual com `CREATE UNIQUE INDEX ... WHERE status = ...`).
model Subscription {
  id                      String             @id @default(cuid())
  workspaceId             String
  planId                  String
  status                  SubscriptionStatus @default(TRIALING)
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean            @default(false)
  externalCustomerId      String?
  externalSubscriptionId  String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([workspaceId])
  @@map("subscriptions")
}

enum UsageMetric {
  MARKETPLACE_ACCOUNTS_CONNECTED
  ORDERS_SYNCED
  MEMBERS_ACTIVE
  AI_SEARCHES
}

/// Contador de uso por período, comparado contra Plan.limits para aplicar
/// feature gates/upsell (ex.: "você atingiu o limite de contas conectadas").
model UsageCounter {
  id          String      @id @default(cuid())
  workspaceId String
  metric      UsageMetric
  periodStart DateTime
  periodEnd   DateTime
  count       Int         @default(0)
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, periodStart])
  @@map("usage_counters")
}
