# Ambiente
NODE_ENV=development
PORT=3333
WEB_APP_URL=http://localhost:3000

# Banco de dados (Postgres — sobe via docker-compose na raiz)
DATABASE_URL="postgresql://hubwin:hubwin@localhost:5432/hubwin?schema=public"

# Redis / filas (BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="troque-por-um-segredo-forte-em-produção"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30
# true em produção (cookies só em HTTPS); false permite dev em http://localhost
COOKIE_SECURE=false

# Gerar com `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
TOKEN_ENCRYPTION_KEY=

# Credenciais de integração (Mercado Livre — https://developers.mercadolivre.com.br/devcenter)
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=

# Shopee Open Platform — ainda não implementado (Mercado Livre primeiro)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=
